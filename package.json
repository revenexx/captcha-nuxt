{
  "name": "@revenexx/captcha-nuxt",
  "version": "0.1.0",
  "description": "One captcha component and one server function for Nuxt, with the provider switched by configuration: the privacy-friendly RevenexxCaptcha (built on Cap), any self-hosted Cap, Friendly Captcha, Cloudflare Turnstile or your own provider. Consent-aware, with a fallback, and optionally configured per tenant by the revenexx platform.",
  "keywords": [
    "nuxt",
    "nuxt-module",
    "nuxt4",
    "captcha",
    "bot-protection",
    "anti-spam",
    "proof-of-work",
    "cap",
    "friendly-captcha",
    "turnstile",
    "cloudflare-turnstile",
    "gdpr",
    "dsgvo",
    "privacy",
    "ssr",
    "revenexx"
  ],
  "homepage": "https://github.com/revenexx/captcha-nuxt#readme",
  "bugs": {
    "url": "https://github.com/revenexx/captcha-nuxt/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/revenexx/captcha-nuxt.git"
  },
  "license": "MIT",
  "author": "revenexx",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/module.mjs",
  "types": "./dist/types.d.mts",
  "files": [
    "dist",
    "CHANGELOG.md",
    "NOTICE"
  ],
  "scripts": {
    "build": "nuxt-module-build prepare && nuxt-module-build build",
    "dev": "nuxi dev playground",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxi prepare playground",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:types": "nuxt-module-build prepare && vue-tsc --noEmit && vue-tsc --noEmit -p src/runtime/server",
    "prepack": "nuxt-module-build prepare && nuxt-module-build build",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "dependencies": {
    "@cap.js/widget": "0.1.58",
    "@friendlycaptcha/sdk": "^1.1.1",
    "@nuxt/kit": "^4.0.0",
    "defu": "^6.1.4",
    "h3": "^1.15.0"
  },
  "peerDependencies": {
    "@nuxt/scripts": "^1.0.0",
    "nuxt": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "@nuxt/scripts": {
      "optional": false
    }
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.0",
    "@nuxt/eslint-config": "^1.9.0",
    "@nuxt/module-builder": "^1.0.2",
    "@nuxt/schema": "^4.2.0",
    "@nuxt/scripts": "^1.3.12",
    "@nuxt/test-utils": "^3.19.2",
    "@types/node": "^22.19.0",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.36.0",
    "happy-dom": "^18.0.1",
    "nuxt": "^4.2.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "vue": "^3.5.22",
    "vue-tsc": "^3.1.0"
  },
  "packageManager": "pnpm@10.23.0",
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@parcel/watcher",
      "unrs-resolver"
    ]
  }
}
